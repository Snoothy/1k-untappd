---
import { normalizeProgress, progressView } from '../lib/progress';
import '../styles/supernova.css';

interface Props {
  username: string;
  displayName: string;
  avatarUrl?: string;
  current: number;
  target: number;
  source?: string;
  updatedAt?: string;
}

const snapshot = normalizeProgress(Astro.props);
if (!snapshot) throw new Error('Invalid unique-beer progress data');
const view = progressView(snapshot);
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<div id="supernova" data-supernova tabindex="-1"
  data-username={snapshot.username} data-display-name={snapshot.displayName}
  data-current={snapshot.current} data-target={snapshot.target}
  data-source={snapshot.source} data-updated-at={snapshot.updatedAt}
  data-progress-url={`${baseUrl}progress.json`}
  class:list={{ 'sn-completed': view.complete }}>

  <section class="sn-stage" aria-labelledby="progress-title">
    <canvas class="sn-canvas" aria-hidden="true"></canvas>
    <div class="sn-vignette" aria-hidden="true"></div>
    <header class="sn-header">
      <a class="sn-brand" href={`https://untappd.com/user/${encodeURIComponent(snapshot.username)}`} aria-label={`Open ${snapshot.displayName} on Untappd`}>
        <span class="sn-seal" aria-hidden="true">{snapshot.displayName.slice(0, 1).toUpperCase()}</span><div><span class="sn-name">{snapshot.displayName}</span><small>THE UNTAPPD ODYSSEY</small></div>
      </a>
      <div class="sn-edition">SUPERNOVA<small class="sn-target-label">ROAD TO {view.target}</small></div>
    </header>
    <div class="sn-manifesto">
      <p class="sn-kicker"><span aria-hidden="true"></span> EVERY BEER, A NEW WORLD.</p>
      <h1 id="progress-title"><span class="sn-title-first">{view.complete ? "LEGEND." : "THE ROAD"}</span><em class="sn-title-last">{view.complete ? "UNLOCKED." : "TO LEGEND."}</em></h1>
      <p class="sn-poem">{snapshot.target === 1000 ? "A thousand beers." : `${view.target} unique beers.`}<br />{view.complete ? "An unforgettable journey." : "A story worth telling."}</p>
      <div class="sn-rule" aria-hidden="true"></div>
    </div>
    <div class="sn-core">
      <p class="sn-eyebrow">{view.complete ? "A LEGEND IS BORN." : "THE JOURNEY SO FAR"}</p>
      <div class="sn-count" aria-label={view.description}>{view.current}</div>
      <p class="sn-unit">{view.complete ? `${view.target} UNIQUE BEERS REACHED` : `OF ${view.target} UNIQUE BEERS`}</p>
    </div>
    <footer class="sn-progress">
      <div class="sn-progress-labels"><span class="sn-complete">{view.percentLabel}</span><span class="sn-remaining">{view.remainingLabel}</span></div>
      <div class="sn-track" role="progressbar" aria-label="Unique beer progress" aria-valuemin="0" aria-valuemax={snapshot.target} aria-valuenow={view.progressValue} aria-valuetext={view.description}><div class="sn-fill" style={{ width: `${view.percentage}%` }}></div></div>
      <div class="sn-bottom"><span>THE NEXT POUR IS HISTORY.</span><div class="sn-source"><span class="sn-demo">{view.sourceLabel}</span><time class="sn-updated" datetime={snapshot.updatedAt || undefined}>{view.updatedLabel}</time></div></div>
    </footer>
    <p class="sn-announcement" aria-live="polite"></p>
  </section>
  <p class="sn-status" role="status"></p>
</div>

<script>
  import { mountSupernova } from '../scripts/supernova';
  document.querySelectorAll<HTMLElement>('[data-supernova]').forEach(mountSupernova);
</script>
