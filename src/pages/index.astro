---
import BeerProgress from '../components/BeerProgress.astro';
import progress from '../data/progress.json';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Snoothy’s road to 1,000 unique beers, brought to life by Supernova." />
    <meta name="theme-color" content="#05080d" />
